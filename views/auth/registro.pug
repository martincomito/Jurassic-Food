extends ../layout

block content
  .contenedor
    .encabezado
      h2 Crear Cuenta
    
    form(method="POST" action="/auth/registro")
      .grupo-formulario
        label(for="nombre") Nombre
        input#nombre(type="text" name="nombre" required)

      .grupo-formulario
        label(for="email") Email
        input#email(type="email" name="email" required)
      
      .grupo-formulario
        label(for="password") Contraseña
        input#password(type="password" name="password" required)
      
      .grupo-formulario
        label(for="rol") Rol
        select#rol(name="rol" required)
          option(value="" disabled selected) Elegir rol
          option(value="cocinero") Cocinero
          option(value="personal_salon") Personal de salón
          option(value="gerente") Gerente
      
      button.boton.boton-exito(type="submit") Registrar
