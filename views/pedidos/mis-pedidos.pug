extends ../layout

block content
  .contenedor
    .encabezado
      h2 Mis pedidos
      a.boton.boton-principal(href="/pedidos/crear") Crear nuevo pedido
    
    if pedidos.length === 0
      p No tenés pedidos hechos.
    else
      table
        thead
          tr
            th ID pedido
            th Fecha
            th Productos
            th Total
            th Estado
            th Acciones
        tbody
          each pedido in pedidos
            tr
              td= pedido._id
              td= new Date(pedido.fechaCreacion).toLocaleDateString()
              td
                ul(style="list-style: none; padding: 0; margin: 0;")
                  each item in pedido.productos
                    if item.producto
                      li #{item.producto.nombre} x #{item.cantidad}
              td $#{pedido.total}
              td= pedido.estado
              td
                if pedido.estado === 'pendiente'
                  button.boton.boton-peligro(onclick=`cancelarPedido('${pedido._id}')`) Cancelar
                else
                  span -

  script.
    async function cancelarPedido(id) {
      if (!confirm('¿Cancelar el pedido?')) return;

      try {
        const response = await fetch(`/pedidos/${id}`, {
          method: 'DELETE',
          credentials: 'same-origin'
        });

        const data = await response.json();

        if (response.ok) {
          alert('Pedido cancelado');
          window.location.reload();
        } else {
          alert(data.mensaje || 'Error al cancelar el pedido');
        }
      } catch (error) {
        console.error(error);
        alert('Error de conexión');
      }
    }
