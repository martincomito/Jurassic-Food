extends ../layout

block content
  h2 Editar producto
  
  if error
    .mensaje-error= error
  
  form(method="POST", action=`/productos/${producto._id}?_method=PUT`)
    input(type="hidden", name="_method", value="PUT")
    
    .fila-formulario
      .grupo-formulario
        label(for="nombre") Nombre del producto:
        input(type="text", id="nombre", name="nombre", value=producto.nombre, required)
      
      .grupo-formulario
        label(for="precio") Precio:
        input(type="number", id="precio", name="precio", value=producto.precio, min="0", step="0.01", required)
    
    .grupo-formulario
      label(for="descripcion") Descripción:
      textarea(id="descripcion", name="descripcion", rows="3")= producto.descripcion

    .grupo-formulario
      label(for="disponible") 
        input(type="checkbox", id="disponible", name="disponible", checked=producto.disponible style="width: auto; margin-right: 10px;")
        | Disponible
    
    .acciones-formulario
      button.boton.boton-exito(type="submit") Actualizar producto
      a.boton.boton-principal(href="/productos") Cancelar

  style.
    .acciones-formulario {
      margin-top: 20px;
      text-align: center;
    }
    .mensaje-error {
      color: #721c24;
      background-color: #f8d7da;
      padding: 10px;
      margin-bottom: 20px;
      border-radius: 4px;
      text-align: center;
    }
