extends ../layout

block content
  .contenedor
    .encabezado
      h2 Registrar nuevo usuario
    
    if error
      .error= error

    form(action=`/usuarios?token=${token}` method="POST")
      input(type="hidden" name="token" value=token)


      .grupo-formulario
        label(for="nombre") Nombre
        input#nombre(type="text" name="nombre" required value=usuario ? usuario.nombre : '')

      .grupo-formulario
        label(for="email") Email
        input#email(type="email" name="email" required value=usuario ? usuario.email : '')
      
      .grupo-formulario
        label(for="password") Contraseña
        input#password(type="password" name="password" required)
      
      .grupo-formulario
        label(for="rol") Rol
        select#rol(name="rol" required)
          option(value="" disabled selected) Seleccionar rol
          option(value="cocinero" selected=usuario && usuario.rol === 'cocinero') Cocinero
          option(value="personal_salon" selected=usuario && usuario.rol === 'personal_salon') Personal de Salón
          option(value="gerente" selected=usuario && usuario.rol === 'gerente') Gerente
      
      button.boton.boton-exito(type="submit") Crear Usuario
      a.boton.boton-peligro(href=`/usuarios?token=${token}`) Cancelar

