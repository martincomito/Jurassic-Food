extends ../layout

block content
  .contenedor
    .encabezado
      h2 Registrar nuevo usuario
    
    if error
      .error= error

    form(action="/usuarios" method="POST")


      .grupo-formulario
        label(for="nombre") Nombre
        input#nombre(type="text" name="nombre" required value=nuevoUsuario ? nuevoUsuario.nombre : '')

      .grupo-formulario
        label(for="email") Email
        input#email(type="email" name="email" required value=nuevoUsuario ? nuevoUsuario.email : '')
      
      .grupo-formulario
        label(for="password") Contraseña
        input#password(type="password" name="password" required)
      
      .grupo-formulario
        label(for="rol") Rol
        select#rol(name="rol" required)
          option(value="" disabled selected) Seleccionar rol
          option(value="cocinero" selected=nuevoUsuario && nuevoUsuario.rol === 'cocinero') Cocinero
          option(value="personal_salon" selected=nuevoUsuario && nuevoUsuario.rol === 'personal_salon') Personal de salón
          option(value="gerente" selected=nuevoUsuario && nuevoUsuario.rol === 'gerente') Gerente
      
      button.boton.boton-exito(type="submit") Crear usuario
      a.boton.boton-peligro(href="/usuarios") Cancelar

