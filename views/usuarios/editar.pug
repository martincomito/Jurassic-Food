extends ../layout

block content
  .contenedor
    .encabezado
      h2 Editar usuario
    
    if error
      .error= error

    form(action=`/usuarios/${usuarioEditar._id}?_method=PUT` method="POST")


      .grupo-formulario
        label(for="nombre") Nombre
        input#nombre(type="text" name="nombre" required value=usuarioEditar.nombre)

      .grupo-formulario
        label(for="email") Email
        input#email(type="email" name="email" required value=usuarioEditar.email)
      
      .grupo-formulario
        label(for="rol") Rol
        if usuarioEditar.rol !== 'cliente'
          select#rol(name="rol" required)
            option(value="cocinero" selected=usuarioEditar.rol === 'cocinero') Cocinero
            option(value="personal_salon" selected=usuarioEditar.rol === 'personal_salon') Personal de salón
            option(value="gerente" selected=usuarioEditar.rol === 'gerente') Gerente
        else
          p Cliente
      
      button.boton.boton-exito(type="submit") Actualizar usuario
      a.boton.boton-peligro(href="/usuarios") Cancelar

